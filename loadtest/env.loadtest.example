# Copy this file to loadtest/.env.loadtest and fill in the values from your
# separate TEST Supabase project (Project Settings -> API). Never use the live
# project here; the load-test scripts refuse to run against it.
#
# Every setting the backend reads is listed so that none of the live values in
# the project's main .env are used by the test server. Email, SMS, AI and
# Turnstile are deliberately left blank: the load test must not send messages
# or spend paid quotas.

SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The local test server listens here; the load generator targets it.
PORT=3101
FRONTEND_ORIGIN=http://127.0.0.1:3101
PASSWORD_OTP_SECRET=loadtest-only-not-a-secret

# Disabled for the load test.
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
CONTACT_EMAIL=
GOOGLE_APPS_SCRIPT_EMAIL_URL=
EMAIL_RELAY_SECRET=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
GEMINI_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
