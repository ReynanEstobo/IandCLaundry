# Server-only values. Use real values only in the ignored .env file.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Automated-email sender and public contact inbox. Use the same value unless
# you deliberately want contact-form messages delivered elsewhere.
GMAIL_EMAIL=iclaundryshop@gmail.com
GMAIL_APP_PASSWORD=
# Shop inbox used only for messages from the public contact form. If blank,
# GMAIL_EMAIL is used instead.
CONTACT_EMAIL=iclaundryshop@gmail.com
# Production email relay for Cloudflare Workers. The URL and shared secret
# belong to the private Google Apps Script deployment; never expose either in
# frontend code or commit real values.
GOOGLE_APPS_SCRIPT_EMAIL_URL=
EMAIL_RELAY_SECRET=
# Random server-only value used to hash password-change OTPs (for example,
# generate a 32+ character value). Never expose this in the frontend.
PASSWORD_OTP_SECRET=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=HCLaundry
GEMINI_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173
PORT=3001
# Cloudflare Turnstile: site key is public; secret key must remain server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
